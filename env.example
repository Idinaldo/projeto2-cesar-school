# -=- BANCO DE DADOS POSTGRESQL -=-
# Example de nome do banco de dados oficial do projeto
POSTGRES_DB=exemplo_samu_dataflow_db

# Exemplo de usuario administrador do banco de dados
POSTGRES_USER=exemplo_samu_app_user

# Senha de acesso ao banco de dados (Substituir por senha forte em producao)
POSTGRES_PASSWORD=ExemploSenhaForte123!#@

# Porta TCP aberta no host para conexao externa ao PostgreSQL
POSTGRES_HOST_PORT=5433

# -=- BACKEND C# -=-
# Porta TCP aberta no host para receber chamadas do Airflow na API
API_HOST_PORT=8001

# Ambiente do ASP.NET Core (Development, Staging ou Production)
ASPNETCORE_ENVIRONMENT=Development

# Chave secreta exigida nas requisicoes HTTP feitas pelo Airflow
API_KEY=CHAVE_API_EXEMPLO_ABC123XYZ

# String de conexao com o banco Oracle de origem do CIE
ORACLE_CONNECTION_STRING=Data Source=exemplo_oracle_cie_host:1521/service_name;User Id=usr_exemplo;Password=senha_exemplo;
